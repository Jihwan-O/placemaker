{
  "_about": "Back gardens that run down to a second street at an angle (the user, 22 Oct: a grass triangle between each back fence and the sidewalk, one per lot: 'WHERE DO THESE COME FROM?'). Houses grow on one street, then a second street is laid behind them at 25 degrees (after the growth, unzoned, so nothing grows on it). Every garden is planned again with the old rule (streetEnd 0: a garden narrowing toward its slanted end is cut square as a spike) and the new one (the default, 1: a garden that ends along the street it backs onto keeps its whole end), the same spots pictured each time. Send with: powershell -File tools/suite/Send-Suite.ps1 -File suite/scenarios/outgrow-back-street.json -Build -Who <you>",
  "scenarios": [
    {
      "id": "back-street-25",
      "land": { "shape": "rect", "size": [400, 360], "ground": "flat", "roads": "none" },
      "steps": [
        { "do": "setting", "name": "NeighbourhoodPolish", "value": true },
        { "do": "setting", "name": "PolishNewHouses", "value": true },
        { "do": "lab", "op": "street", "shape": "straight", "at": [0, 70], "yaw": 0, "length": 120, "zone": "NA Residential Low" },
        { "do": "grow", "seconds": 150 },
        { "do": "lab", "op": "street", "shape": "straight", "at": [0, -28], "yaw": -25, "length": 280, "zone": "none" },
        { "do": "lab", "op": "polishIdle", "seconds": 120 },
        { "do": "lab", "op": "polishSettings", "settings": { "streetEnd": 0 } },
        { "do": "lab", "op": "polishIdle", "seconds": 180 },
        { "do": "lab", "op": "fenceMap", "label": "square-ends" },
        { "do": "shot", "name": "before-top", "camera": { "target": "point", "at": [0, 15], "view": "top", "distance": 160 }, "shotMode": "render" },
        { "do": "shot", "name": "before-close", "camera": { "target": "point", "at": [-20, 20], "view": "top", "distance": 80 }, "shotMode": "render" },
        { "do": "shot", "name": "before-45", "camera": { "target": "point", "at": [0, 10], "view": "oblique", "pitch": 45, "distance": 120 }, "shotMode": "render" },
        { "do": "lab", "op": "polishSettings", "settings": { "streetEnd": 1 } },
        { "do": "lab", "op": "polishIdle", "seconds": 180 },
        { "do": "lab", "op": "fenceMap", "label": "street-ends" },
        { "do": "shot", "name": "after-top", "camera": { "target": "point", "at": [0, 15], "view": "top", "distance": 160 }, "shotMode": "render" },
        { "do": "shot", "name": "after-close", "camera": { "target": "point", "at": [-20, 20], "view": "top", "distance": 80 }, "shotMode": "render" },
        { "do": "shot", "name": "after-45", "camera": { "target": "point", "at": [0, 10], "view": "oblique", "pitch": 45, "distance": 120 }, "shotMode": "render" }
      ]
    }
  ]
}
