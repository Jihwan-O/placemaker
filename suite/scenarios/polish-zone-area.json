{
  "_about": "The Zoning category's 'Zone this area' (phase 2 and 3): an unzoned street, its land picked with Paint area, the Garden look with Zone this area on (70% low density homes, 30% low density shops in clumps), Build zones the cells; houses grow there and get the Garden look (the look area). Send with tools/hot/Send-Hot.ps1 -Build -File suite/scenarios/polish-zone-area.json.",
  "scenarios": [
    {
      "id": "polish-zone-area",
      "land": { "shape": "rect", "size": [320, 240], "ground": "flat", "roads": "none" },
      "steps": [
        { "do": "setting", "name": "PolishNewHouses", "value": false },
        { "do": "lab", "op": "street", "shape": "arc", "radius": 120, "from": 40, "to": 140, "zone": "none" },
        { "do": "wait", "seconds": 2 },
        { "do": "area", "tool": "paint", "size": 80, "cameraDistance": 520, "stroke": [[-110, -60], [-60, 0], [-20, 40], [30, 60]] },
        { "do": "type", "layer": "polishGarden", "preset": "standard" },
        { "do": "value", "path": "0", "id": "zoneArea", "value": true },
        { "do": "value", "path": "0", "id": "shareA", "value": 70 },
        { "do": "value", "path": "0", "id": "shareB", "value": 30 },
        { "do": "value", "path": "0", "id": "zoneGrain", "value": 3 },
        { "do": "shot", "name": "design-ui", "camera": { "target": "point", "at": [-40, 0], "view": "oblique", "pitch": 60, "distance": 320 }, "shotMode": "ui" },
        { "do": "build" },
        { "do": "wait", "seconds": 3 },
        { "do": "shot", "name": "zoned-top", "camera": { "target": "point", "at": [-40, 0], "view": "top", "distance": 380 }, "shotMode": "render", "zones": true },
        { "do": "grow", "seconds": 120 },
        { "do": "lab", "op": "polishIdle", "seconds": 180 },
        { "do": "shot", "name": "grown-45", "camera": { "target": "point", "at": [-40, 0], "view": "oblique", "pitch": 50, "distance": 200 }, "shotMode": "render" },
        { "do": "shot", "name": "grown-top", "camera": { "target": "point", "at": [-40, 0], "view": "top", "distance": 380 }, "shotMode": "render" },
        { "do": "setting", "name": "PolishNewHouses", "value": true }
      ]
    }
  ]
}
